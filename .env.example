# paper-bro configuration. Copy to .env for local runs, and set the same
# variables wherever you deploy.

# --- Database (required) ---
# Postgres, local or hosted; pooled or direct both work, migrations run at boot.
# Self-hosted example: postgresql://paperbro:paperbro@localhost:5432/paperbro
NEON_DB=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Publishing to AERO (optional) ---
# Only needed when PUBLISH=1. A self-hosted install that previews courses
# locally (PUBLISH=0, the default) doesn't need an AERO account at all.
# AERO_TOKEN=

# --- Model API ---
# Any OpenAI-compatible chat-completions server, hosted or your own (vLLM,
# Ollama, LM Studio, ...). You can configure several providers: give each one
# its own LLM_<NAME>_* block below; LLM_DEFAULT chooses which is used unless a
# request names one. The name is lowercase, and the default provider is also
# known as "default", which is the name the plain LLM_* variables configure.
# The server must stream usage (stream_options.include_usage) and support
# strict json_schema output. Costs are counted at the per-provider prices
# below, so set PRICE_INPUT/CACHED/OUTPUT to match what you pay (USD per
# million tokens); adjust DAILY_BUDGET_USD accordingly. Use https for a
# server that is not on this machine: the key is sent as a bearer token, so
# over plain http anyone on the path can read it (paper-bro warns at startup).
#
# The base URL goes up to and including /v1; /chat/completions is added.

# --- Provider "default" (plain LLM_* keeps working as before) ---
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=
# Leave empty for a server that needs no key.
LLM_API_KEY=
# Used automatically if LLM_MODEL stops existing (HTTP 404). Default: none.
# LLM_FALLBACK_MODEL=
# Send reasoning_effort (default on) and use JSON mode schema/object/text.
# LLM_REASONING=1
# LLM_JSON_MODE=schema
# Price per million tokens, USD (defaults: input 1.25 / cached 0.15 / output 4.25).
# LLM_PRICE_INPUT=1.25
# LLM_PRICE_CACHED=0.15
# LLM_PRICE_OUTPUT=4.25

# --- Provider "ollama" (local, example) ---
# A local Ollama server needs no key and costs nothing. Note: small local
# models produce noticeably worse courses than the frontier APIs below.
# LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LLM_OLLAMA_MODEL=llama3.1:8b
# LLM_OLLAMA_REASONING=0
# LLM_OLLAMA_JSON_MODE=object

# --- Provider "openai" (hosted, example) ---
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=gpt-4o
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_REASONING=1
# LLM_OPENAI_JSON_MODE=schema
# LLM_OPENAI_PRICE_INPUT=2.50
# LLM_OPENAI_PRICE_CACHED=1.25
# LLM_OPENAI_PRICE_OUTPUT=10.00

# Which provider a build uses when none is named.
# LLM_DEFAULT=default

# --- Local preview vs publishing ---
# 1 publishes finished courses to AERO (needs AERO_TOKEN). 0 (the default)
# keeps them in the database and serves them at /paper-bro/preview/<alias> on
# LISTEN.
PUBLISH=0
# Only meaningful when PUBLISH=1.
# AERO_MCP_URL=https://aero.oops.wtf/mcp
# PUBLIC_ORIGIN=https://aero.oops.wtf

# --- Front end hosting (optional) ---
# Empty by default: the app serves its own files and sends no analytics.
# Set ANALYTICS_ID (a GA4 measurement id) to inject your own tag, and
# ASSET_CDN (a URL ending in /paper-bro/) to fetch static files from there
# first, falling back to this server.
# ANALYTICS_ID=
# ASSET_CDN=

# --- Browser QA ---
# chrome-headless-shell from Chrome for Testing, pinned; see README.md.
CHROME_PATH=.chrome/chrome-headless-shell-mac-arm64/chrome-headless-shell

# --- Server ---
LISTEN=127.0.0.1:8083
# Admin routes have no auth, so this must stay on loopback.
ADMIN_LISTEN=127.0.0.1:8085
# Build workers. Default: 2 when PUBLISH=1, none in a dry run, so a local
# server never takes real requests off a shared queue.
# WORKERS=2

# --- Limits ---
BUILDS_PER_IP_PER_DAY=3
BUILDS_PER_DAY=40
MAX_QUEUED=20
DAILY_BUDGET_USD=50
